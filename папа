<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Папе с уважением · 27.04.2014</title>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: 'Comfortaa', cursive, sans-serif;
      background: linear-gradient(135deg, #e6f2ff 0%, #d4e4f7 100%);
      color: #2c3e50;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }
    .container {
      max-width: 600px;
      width: 100%;
      text-align: center;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 40px 25px;
      box-shadow: 0 20px 50px rgba(161, 196, 253, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.8);
      position: relative;
      z-index: 10;
    }
    .date {
      font-weight: bold;
      color: #5a7a8a;
      letter-spacing: 3px;
      margin-bottom: 15px;
      font-size: 0.9rem;
    }
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: #34495e;
      margin-bottom: 20px;
    }
    p {
      font-size: 1.05rem;
      line-height: 1.8;
      margin-bottom: 20px;
      color: #3b4d5e;
    }
    
    /* Интерактивный кулачок */
    .fist-btn {
      background: none;
      border: none;
      font-size: 80px;
      cursor: pointer;
      margin: 20px 0;
      filter: drop-shadow(0 10px 15px rgba(90, 122, 138, 0.4));
      transition: transform 0.1s;
      user-select: none;
    }
    .fist-btn:active {
      transform: scale(0.8) translateY(10px); /* Эффект удара */
    }
    
    /* Письмо */
    .letter {
      display: none;
      text-align: left;
      background: #f8fbff;
      padding: 25px;
      border-radius: 20px;
      border-left: 5px solid #a1c4fd;
      box-shadow: inset 0 0 20px rgba(161, 196, 253, 0.2);
      animation: unfold 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      margin-top: 10px;
      transform-origin: top;
    }
    .letter.show { display: block; }
    .letter h2 {
      font-family: 'Playfair Display', serif;
      color: #34495e;
      margin-bottom: 15px;
      font-size: 1.5rem;
    }
    .signature {
      text-align: right;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.3rem;
      color: #5a7a8a;
      margin-top: 20px;
    }

    @keyframes unfold { 
      from { opacity: 0; transform: scaleY(0); } 
      to { opacity: 1; transform: scaleY(1); } 
    }

    /* Ударная волна и искры */
    .shockwave {
      position: fixed;
      border: 4px solid #a1c4fd;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      animation: expand 0.6s ease-out forwards;
    }
    @keyframes expand {
      0% { width: 0; height: 0; opacity: 1; }
      100% { width: 300px; height: 300px; opacity: 0; margin-left: -150px; margin-top: -150px; }
    }

    .fly-spark {
      position: fixed;
      pointer-events: none;
      font-size: 20px;
      z-index: 9999;
      animation: flySpark 1.5s ease-out forwards;
    }
    @keyframes flySpark {
      0% { transform: translate(0, 0) scale(1); opacity: 1; }
      100% { transform: translate(var(--x), var(--y)) scale(0); opacity: 0; }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="date">27 АПРЕЛЯ 2014</div>
    <h1>Дорогой Папа</h1>
    
    <p>Ты — наша опора и защита. Я знаю, что тебе бывает сложно говорить о чувствах, но иногда это очень нужно.</p>
    <p>Помнишь день вашего венчания? Это было ваше общее обещание. Я не хочу учить тебя жизни, я просто прошу: услышь маму.</p>
    
    <!-- Интерактивный кулак -->
    <button class="fist-btn" id="fistBtn">👊</button>
    <p style="font-size: 0.9rem; color: #5a7a8a; margin-top: -10px;">Жми сюда</p>
    
    <div class="letter" id="letter">
      <h2>Мой дорогой Папа,</h2>
      <p>Вот это удар! Спасибо, что нажал. Я знаю, что ты многое держишь в себе. Я не хочу быть судьёй в ваших спорах. Я просто твой сын, который гордится тобой и любит вас с мамой.</p>
      <p>Вы с мамой вместе уже много лет. 27 апреля 2014 года вы венчались. Это был ваш выбор и ваше слово. У вас есть общая история, которую никто не отменял.</p>
      <p>Найди, пожалуйста, в себе силы поговорить с мамой сегодня. Без крика, по-мужски, спокойно. Скажи ей, что чувствуешь, и попробуй услышать её. Семья — это самое главное.</p>
      <div class="signature">Твой сын.</div>
    </div>
  </div>

  <script>
    const fistBtn = document.getElementById('fistBtn');
    const letter = document.getElementById('letter');

    fistBtn.addEventListener('click', (e) => {
      // Убираем кулак
      fistBtn.style.display = 'none';
      // Показываем письмо
      letter.classList.add('show');
      
      // Координаты для эффектов
      const rect = fistBtn.getBoundingClientRect();
      const startX = rect.left + rect.width / 2;
      const startY = rect.top + rect.height / 2;

      // Создаем ударную волну
      const shockwave = document.createElement('div');
      shockwave.classList.add('shockwave');
      shockwave.style.left = startX + 'px';
      shockwave.style.top = startY + 'px';
      document.body.appendChild(shockwave);
      setTimeout(() => shockwave.remove(), 600);

      // Создаем искры (разлетаются в разные стороны)
      for (let i = 0; i < 20; i++) {
        createSpark(startX, startY);
      }
    });

    function createSpark(x, y) {
      const spark = document.createElement('div');
      spark.classList.add('fly-spark');
      spark.innerText = ['✨', '⚡', '💥', '💙'][Math.floor(Math.random() * 4)];
      
      spark.style.left = x + 'px';
      spark.style.top = y + 'px';
      
      // Задаем случайное направление разлета через CSS переменные
      const angle = Math.random() * Math.PI * 2;
      const distance = Math.random() * 150 + 50;
      spark.style.setProperty('--x', Math.cos(angle) * distance + 'px');
      spark.style.setProperty('--y', Math.sin(angle) * distance + 'px');
      
      document.body.appendChild(spark);
      setTimeout(() => spark.remove(), 1500);
    }
  </script>
</body>
</html>
