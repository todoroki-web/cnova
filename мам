<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Маме с любовью · 27.04.2014</title>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: 'Comfortaa', cursive, sans-serif;
      background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 100%);
      color: #4a3b3b;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }
    .container {
      max-width: 600px;
      width: 100%;
      text-align: center;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      border-radius: 30px;
      padding: 40px 25px;
      box-shadow: 0 20px 50px rgba(255, 182, 193, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.8);
      position: relative;
      z-index: 10;
    }
    .date {
      font-weight: bold;
      color: #d87093;
      letter-spacing: 3px;
      margin-bottom: 15px;
      font-size: 0.9rem;
    }
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: #c71585;
      margin-bottom: 20px;
    }
    p {
      font-size: 1.05rem;
      line-height: 1.8;
      margin-bottom: 20px;
      color: #5a4a4a;
    }
    
    /* Интерактивная кнопка удержания */
    .hold-btn {
      position: relative;
      background: #fff;
      border: 2px solid #ffb6c1;
      color: #c71585;
      font-family: 'Comfortaa', cursive;
      font-weight: bold;
      font-size: 1.1rem;
      padding: 15px 30px;
      border-radius: 50px;
      cursor: pointer;
      overflow: hidden;
      transition: all 0.3s;
      margin: 20px 0;
      outline: none;
      box-shadow: 0 5px 15px rgba(255, 182, 193, 0.3);
    }
    .hold-btn .fill {
      position: absolute;
      top: 0; left: 0; height: 100%; width: 0%;
      background: linear-gradient(90deg, #ffb6c1, #ff69b4);
      z-index: -1;
      transition: width 0.1s linear;
    }
    .hold-btn:active {
      transform: scale(0.98);
    }

    /* Письмо */
    .letter {
      display: none;
      text-align: left;
      background: #fffafa;
      padding: 25px;
      border-radius: 20px;
      border-left: 5px solid #ffb6c1;
      box-shadow: inset 0 0 20px rgba(255, 182, 193, 0.2);
      animation: slideUp 0.8s ease;
      margin-top: 10px;
    }
    .letter.show { display: block; }
    .letter h2 {
      font-family: 'Playfair Display', serif;
      color: #c71585;
      margin-bottom: 15px;
      font-size: 1.5rem;
    }
    .signature {
      text-align: right;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.3rem;
      color: #d87093;
      margin-top: 20px;
    }

    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    /* Летящие лепестки */
    .fly-petal {
      position: fixed;
      pointer-events: none;
      font-size: 30px;
      z-index: 9999;
      animation: flyUp 2.5s ease-out forwards;
    }
    @keyframes flyUp {
      0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
      100% { transform: translateY(-300px) rotate(360deg) scale(1.5); opacity: 0; }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="date">27 АПРЕЛЯ 2014</div>
    <h1>Дорогая Мама</h1>
    
    <p>Ты — сердце нашего дома. Я знаю, как иногда бывает тяжело и как много ты держишь в себе.</p>
    <p>Я не прошу тебя забыть обиды. Я просто очень хочу, чтобы ты вспомнила тот день, когда вы с папой сказали друг другу самые важные слова.</p>
    
    <!-- Кнопка с удержанием -->
    <button class="hold-btn" id="holdBtn">
      <div class="fill" id="fill"></div>
      Нажми и удерживай, чтобы открыть
    </button>
    
    <div class="letter" id="letter">
      <h2>Моя любимая Мама,</h2>
      <p>Спасибо, что досмотрела до конца. Пожалуйста, услышь меня. Я не хочу быть судьёй между вами. Я просто твой сын, который любит вас обоих одинаково сильно.</p>
      <p>Вы с папой прошли вместе через многое. 27.04.2014 навсегда связало вас узами венчания. В мире нет ничего важнее семьи.</p>
      <p>Сделай, пожалуйста, первый шаг. Поговори с папой сегодня. Спокойно, по-доброму. Ради нас, ради тебя, ради него.</p>
      <div class="signature">Твой сын.</div>
    </div>
  </div>

  <script>
    const holdBtn = document.getElementById('holdBtn');
    const fill = document.getElementById('fill');
    const letter = document.getElementById('letter');
    
    let holdTimer;
    let holdProgress = 0;
    const holdTimeRequired = 1500; // Время удержания (1.5 сек)
    const intervalTime = 50; // Частота обновления

    // Функция старта удержания
    function startHold(e) {
      e.preventDefault(); // Предотвращаем выделение текста на мобильных
      holdProgress = 0;
      fill.style.width = '0%';
      
      holdTimer = setInterval(() => {
        holdProgress += intervalTime;
        let percent = (holdProgress / holdTimeRequired) * 100;
        fill.style.width = percent + '%';
        
        if (holdProgress >= holdTimeRequired) {
          clearInterval(holdTimer);
          revealLetter();
        }
      }, intervalTime);
    }

    // Функция отмены удержания
    function cancelHold() {
      clearInterval(holdTimer);
      if (holdProgress < holdTimeRequired) {
        fill.style.width = '0%';
        holdProgress = 0;
      }
    }

    // Показ письма
    function revealLetter() {
      holdBtn.style.display = 'none';
      letter.classList.add('show');
      
      // Эффект лепестков
      const rect = holdBtn.getBoundingClientRect();
      const startX = rect.left + rect.width / 2;
      const startY = rect.top + rect.height / 2;

      for (let i = 0; i < 25; i++) {
        createPetal(startX, startY);
      }
    }

    // Создание лепестка
    function createPetal(x, y) {
      const petal = document.createElement('div');
      petal.classList.add('fly-petal');
      // Эмодзи цветов и сердец
      petal.innerText = ['🌸', '🌺', '💖', '💮'][Math.floor(Math.random() * 4)];
      petal.style.left = (x + (Math.random() - 0.5) * 200) + 'px';
      petal.style.top = (y + (Math.random() - 0.5) * 50) + 'px';
      petal.style.animationDelay = Math.random() * 0.5 + 's';
      document.body.appendChild(petal);
      setTimeout(() => petal.remove(), 3000);
    }

    // Обработчики событий (мышь и тач)
    holdBtn.addEventListener('mousedown', startHold);
    holdBtn.addEventListener('touchstart', startHold);
    
    holdBtn.addEventListener('mouseup', cancelHold);
    holdBtn.addEventListener('mouseleave', cancelHold);
    holdBtn.addEventListener('touchend', cancelHold);
  </script>
</body>
</html>
