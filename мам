<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Маме с любовью</title>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: 'Comfortaa', cursive, sans-serif;
      background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 100%);
      color: #4a3b3b;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }
    .container {
      max-width: 600px;
      width: 100%;
      text-align: center;
      background: rgba(255, 255, 255, 0.7);
      border-radius: 30px;
      padding: 40px 25px;
      box-shadow: 0 20px 50px rgba(255, 182, 193, 0.3);
      border: 1px solid #fff;
    }
    h1 { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: #c71585; margin-bottom: 20px; }
    p { font-size: 1.05rem; line-height: 1.8; margin-bottom: 20px; color: #5a4a4a; }
    
    /* Кнопка */
    .hold-btn {
      position: relative;
      background: #fff;
      border: 2px solid #ffb6c1;
      color: #c71585;
      font-family: 'Comfortaa', cursive;
      font-weight: bold;
      font-size: 1.1rem;
      padding: 15px 30px;
      border-radius: 50px;
      cursor: pointer;
      overflow: hidden;
      margin: 20px 0;
      box-shadow: 0 5px 15px rgba(255, 182, 193, 0.3);
      user-select: none;
      outline: none;
    }
    .hold-btn .fill {
      position: absolute;
      top: 0; left: 0; height: 100%; width: 0%;
      background: linear-gradient(90deg, #ffb6c1, #ff69b4);
      z-index: 1;
    }
    .hold-btn .btn-text {
      position: relative;
      z-index: 2;
    }

    /* Письмо */
    .letter {
      display: none;
      text-align: left;
      background: #fffafa;
      padding: 25px;
      border-radius: 20px;
      border-left: 5px solid #ffb6c1;
      margin-top: 10px;
    }
    .letter h2 { color: #c71585; margin-bottom: 15px; font-size: 1.5rem; }
    .signature { text-align: right; font-style: italic; font-size: 1.3rem; color: #d87093; margin-top: 20px; }

    .fly-petal { position: fixed; pointer-events: none; font-size: 30px; z-index: 9999; animation: flyUp 2.5s ease-out forwards; }
    @keyframes flyUp { 0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translateY(-300px) rotate(360deg) scale(1.5); opacity: 0; } }
  </style>
</head>
<body>
  <div class="container">
    <h1>Дорогая Мама</h1>
    <p>Ты — сердце нашего дома. Я знаю, как иногда бывает тяжело и как много ты держишь в себе.</p>
    <p>Пожалуйста, зажми кнопку внизу, чтобы открыть мое послание.</p>
    
    <button class="hold-btn" id="holdBtn">
      <div class="fill" id="fill"></div>
      <span class="btn-text">Нажми и удерживай</span>
    </button>
    
    <div class="letter" id="letter">
      <h2>Моя любимая Мама,</h2>
      <p>Спасибо, что досмотрела. Я не хочу быть судьёй между вами. Я просто твой сын, который любит вас обоих одинаково сильно.</p>
      <p>Вы с папой прошли вместе через многое. 27.04.2014 навсегда связало вас узами венчания. В мире нет ничего важнее семьи.</p>
      <p>Сделай, пожалуйста, первый шаг. Поговори с папой сегодня. Спокойно, по-доброму.</p>
      <div class="signature">Твой сын.</div>
    </div>
  </div>

  <script>
    // Проверяем, загрузился ли скрипт
    console.log("Скрипт для мамы загружен!");

    var holdBtn = document.getElementById('holdBtn');
    var fill = document.getElementById('fill');
    var letter = document.getElementById('letter');
    var holdTimer;
    var holdProgress = 0;
    var holdTimeRequired = 1500; // 1.5 секунды

    function startHold(e) {
      if(e.cancelable) e.preventDefault(); // Защита от выделения текста
      holdProgress = 0;
      fill.style.width = '0%';
      
      holdTimer = setInterval(function() {
        holdProgress += 50;
        var percent = (holdProgress / holdTimeRequired) * 100;
        if (percent > 100) percent = 100;
        fill.style.width = percent + '%';
        
        if (holdProgress >= holdTimeRequired) {
          clearInterval(holdTimer);
          revealLetter();
        }
      }, 50);
    }

    function cancelHold() {
      clearInterval(holdTimer);
      if (holdProgress < holdTimeRequired) {
        fill.style.width = '0%';
        holdProgress = 0;
      }
    }

    function revealLetter() {
      holdBtn.style.display = 'none';
      letter.style.display = 'block';
      
      // Лепестки
      for (var i = 0; i < 20; i++) {
        var petal = document.createElement('div');
        petal.className = 'fly-petal';
        petal.innerText = ['🌸', '🌺', '💖', '💮'][Math.floor(Math.random() * 4)];
        petal.style.left = (window.innerWidth / 2 + (Math.random() - 0.5) * 200) + 'px';
        petal.style.top = (window.innerHeight / 2) + 'px';
        petal.style.animationDelay = Math.random() * 0.5 + 's';
        document.body.appendChild(petal);
        setTimeout(function(p) { return function() { p.remove(); }; }(petal), 3000);
      }
    }

    // Старые добрые события, работают везде
    holdBtn.addEventListener('mousedown', startHold);
    holdBtn.addEventListener('touchstart', startHold, {passive: false});
    
    holdBtn.addEventListener('mouseup', cancelHold);
    holdBtn.addEventListener('mouseleave', cancelHold);
    holdBtn.addEventListener('touchend', cancelHold);
    holdBtn.addEventListener('touchcancel', cancelHold);
  </script>
</body>
</html>
